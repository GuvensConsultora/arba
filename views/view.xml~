
<odoo>
  <record id="view_archivo_comprimido_form" model="ir.ui.view">
    <field name="name">archivo.comprimido.form</field>
    <field name="model">arba.archivo_comprimido</field>
    <field name="arch" type="xml">
      <form string="Archivo Comprimido">
        <sheet>
          <group>
            <field name="name"/>
            <field name="archivo_zip" filename="archivo_zip_filename"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>


  <!-- Acción para abrir la vista del modelo -->
  <record id="action_archivo_comprimido" model="ir.actions.act_window">
    <field name="name">Archivos Comprimidos</field>
    <field name="res_model">arba.archivo_comprimido</field>
    <field name="view_mode">tree,form</field>
  </record>

  <!-- Menú principal si no existe -->
  <menuitem id="menu_arba_root" name="ARBA" sequence="10"/>

  <!-- Menú secundario -->
  <menuitem id="menu_archivo_comprimido"
            name="Archivos Comprimidos"
            parent="menu_arba_root"
            action="action_archivo_comprimido"
            sequence="10"/>

</odoo>

