<odoo>
    <record id="view_account_tax_csv_export_form" model="ir.ui.view">
        <field name="name">account.tax.csv.export.form</field>
        <field name="model">account.tax.csv.export</field>
        <field name="arch" type="xml">
            <form string="Exportación CSV de Impuestos">
                <sheet>
                    <group>
                        <field name="name"/>
                        <button name="generate_csv_file" type="object" string="Generar CSV" class="btn-primary"/>
                        <field name="file_name" readonly="1"/>
                        <field name="csv_file" filename="file_name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_account_tax_csv_export" model="ir.actions.act_window">
        <field name="name">Exportar CSV de Impuestos</field>
        <field name="res_model">account.tax.csv.export</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

    <!-- Menú principal si no existe -->
    <menuitem id="menu_arba_root" name="ARBA" sequence="10"/>

    <!-- Menú secundario -->

    <menuitem id="menu_account_tax_csv_export" name="Exportar CSV Impuestos"
              parent="account.menu_finance_configuration"
	      parent="menu_arba_root"
	      action="action_account_tax_csv_export"
	      sequence="10"/>
</odoo>
