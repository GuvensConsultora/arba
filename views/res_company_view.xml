<odoo>
  <!-- Por qué: el campo automatic_withholdings está en res.company
       (definido por account_withholding_automatic) pero no tiene vista.
       Se hereda el form de compañía para exponerlo como checkbox. -->
  <record id="view_company_form_withholding" model="ir.ui.view">
    <field name="name">res.company.form.withholding</field>
    <field name="model">res.company</field>
    <field name="inherit_id" ref="base.view_company_form"/>
    <field name="arch" type="xml">
      <xpath expr="//page[@name='general_info']" position="after">
        <page string="Retenciones" name="withholdings">
          <group>
            <field name="automatic_withholdings"
                   string="Retenciones automaticas"
                   help="Aplicar retenciones automaticamente al confirmar pagos"/>
          </group>
        </page>
      </xpath>
    </field>
  </record>
</odoo>
