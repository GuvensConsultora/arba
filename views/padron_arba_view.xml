<odoo>
  <record id="view_padron_arba_form" model="ir.ui.view">
    <field name="name">padron.arba.form</field>
    <field name="model">arba.padron</field>
    <field name="arch" type="xml">
      <form string="Padrón ARBA">
        <sheet>
          <group>
            <field name="name"/>
            <field name="inicio"/>
            <field name="fin"/>
            <field name="cuit"/>
            <field name="par_uno"/>
            <field name="par_dos"/>
            <field name="par_tres"/>
            <field name="tasa"/>
            <field name="codigo"/>
	    <field name="id_pos_imp"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_padron_arba_tree" model="ir.ui.view">
    <field name="name">padron.arba.tree</field>
    <field name="model">arba.padron</field>
    <field name="arch" type="xml">
      <tree string="Padrones ARBA">
        <field name="name"/>
        <field name="cuit"/>
        <field name="tasa"/>
        <field name="codigo"/>
	<field name="id_pos_imp"/>
      </tree>
    </field>
  </record>

  <record id="view_padron_arba_search" model="ir.ui.view">
    <field name="name">padron.arba.search</field>
    <field name="model">arba.padron</field>
    <field name="arch" type="xml">
      <search>
	<field name="cuit"/>
      </search>
    </field>
  </record>

  <!-- Por qué: vista tree específica para retenciones, muestra tipo para distinguir -->
  <record id="view_padron_arba_ret_tree" model="ir.ui.view">
    <field name="name">padron.arba.ret.tree</field>
    <field name="model">arba.padron</field>
    <field name="arch" type="xml">
      <tree string="Padrón Retenciones ARBA">
        <field name="tipo"/>
        <field name="name"/>
        <field name="cuit"/>
        <field name="inicio"/>
        <field name="fin"/>
        <field name="tasa"/>
        <field name="codigo"/>
      </tree>
    </field>
  </record>

  <!-- Acción percepciones (filtro tipo P%) -->
  <record id="action_padron_arba" model="ir.actions.act_window">
    <field name="name">Padrón Percepciones</field>
    <field name="res_model">arba.padron</field>
    <field name="view_mode">tree,form</field>
    <field name="domain">[('tipo', '=like', 'P%')]</field>
  </record>

  <!-- Acción retenciones (filtro tipo R%) -->
  <record id="action_padron_arba_ret" model="ir.actions.act_window">
    <field name="name">Padrón Retenciones</field>
    <field name="res_model">arba.padron</field>
    <field name="view_mode">tree,form</field>
    <field name="domain">[('tipo', '=like', 'R%')]</field>
    <field name="view_id" ref="view_padron_arba_ret_tree"/>
  </record>

  <menuitem id="menu_padron_arba"
            name="Padrón Percepciones"
            parent="menu_arba_root"
            action="action_padron_arba"
            sequence="20"/>

  <menuitem id="menu_padron_arba_ret"
            name="Padrón Retenciones"
            parent="menu_arba_root"
            action="action_padron_arba_ret"
            sequence="21"/>
</odoo>
