
<odoo>
  <data noupdate="1">
    <record id="ir_cron_my_scheduled_action" model="ir.cron">
      <field name="name">Cargar Padron de percepciones</field>
      <field name="model_id" ref="arba.model_arba_archivo_comprimido"/>
      <field name="state">code</field>
      <field name="code">model.my_scheduled_action()</field>
      <field name="user_id" ref="base.user_root"/>
      <field name="interval_type">minutes</field>
      <field name="interval_number">5</field> <!-- Ejecutar cada 30 minutos -->
      <field name="numbercall">-1</field> <!-- -1 para ilimitado -->
    </record>
    <record id="ir_eliminar_percepciones" model="ir.cron">
      <field name="name">Eliminar Padron de percepciones</field>
      <field name="model_id" ref="arba.model_arba_archivo_comprimido"/>
      <field name="state">code</field>
      <field name="code">model.action_eliminar_percepciones()</field>
      <field name="user_id" ref="base.user_root"/>
      <field name="interval_type">minutes</field>
      <field name="interval_number">5</field> <!-- Ejecutar cada 5  minutos -->
      <field name="numbercall">-1</field> <!-- -1 para ilimitado -->
    </record>
  </data>
</odoo>
