<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Mail template Orden de Pago con texto en español.
             Por qué: el template OCA está en inglés y dice "Receipt".
             Este template se usa junto con adjuntos generados por action_payment_sent
             (recibo PDF + certificados de retención). -->

        <record id="email_template_payment_group" model="mail.template">
            <field name="name">Orden de Pago - Enviar por Email</field>
            <field name="email_from">${(object.company_id.email or '')|safe}</field>
            <field name="subject">${object.company_id.name|safe} - Orden de Pago ${object.display_name or ''}</field>
            <field name="partner_to">${object.partner_id.id}</field>
            <field name="model_id" ref="account_payment_group.model_account_payment_group"/>
            <field name="auto_delete" eval="True"/>
            <field name="lang">${object.partner_id.lang}</field>
            <field name="body_html"><![CDATA[
<div style="font-family: Arial, sans-serif; font-size: 13px; color: #333;">
    <p>Estimado/a <strong>${object.partner_id.commercial_partner_id.name}</strong>,</p>

    <p>Se emite comprobantes de pagos a fin de tomar conocimiento del mismo.</p>

    <p style="border-left: 3px solid #1a3e5c; padding-left: 12px; margin: 16px 0;">
        <strong>Orden de Pago:</strong> ${object.display_name}<br/>
        <strong>Fecha:</strong> ${object.payment_date}<br/>
        <strong>Importe Total:</strong> ${object.payments_amount}<br/>
    </p>

    <p>Adjuntamos la Orden de Pago y los Certificados de Retención correspondientes.</p>

    <p>Ante cualquier consulta, no dude en contactarnos.</p>

    <p>Saludos cordiales,<br/>
    <strong>${object.company_id.name}</strong></p>
</div>
            ]]></field>
        </record>

    </data>
</odoo>
