<odoo>
  <data noupdate="1">
    <!-- Grupo de impuestos para retenciones IIBB ARBA -->
    <record id="tax_group_ret_iibb_arba" model="account.tax.group">
      <field name="name">Ret IIBB ARBA</field>
      <field name="sequence">15</field>
    </record>

    <!-- Impuesto de retención IIBB ARBA (supplier, withholding_type=partner_tax)
         Por qué: withholding_type='partner_tax' hace que el motor OCA
         lea la alícuota de res.partner.perception automáticamente.
         Nota: el usuario debe configurar la cuenta contable manualmente. -->
    <record id="tax_ret_iibb_arba" model="account.tax">
      <field name="name">Ret IIBB ARBA</field>
      <field name="type_tax_use">supplier</field>
      <field name="amount_type">percent</field>
      <field name="amount">0</field>
      <field name="tax_group_id" ref="tax_group_ret_iibb_arba"/>
      <field name="withholding_type">partner_tax</field>
      <field name="withholding_amount_type">untaxed_amount</field>
    </record>

    <!-- Secuencia para numeración de retenciones IIBB ARBA -->
    <record id="seq_ret_iibb_arba" model="ir.sequence">
      <field name="name">Retención IIBB ARBA</field>
      <field name="code">account.payment.ret.iibb.arba</field>
      <field name="prefix">RET-ARBA-</field>
      <field name="padding">8</field>
      <field name="company_id" eval="False"/>
    </record>
  </data>
</odoo>
