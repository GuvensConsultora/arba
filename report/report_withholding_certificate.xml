<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Certificado de retención IIBB/Ganancias - formato legal.
             Datos obligatorios según normativa ARBA:
             - Denominación y numeración correlativa del certificado
             - Agente: razón social, CUIT, nro IIBB, nro agente retención, domicilio
             - Retenido: razón social, CUIT, nro IIBB, domicilio
             - Operación: base imponible, alícuota, monto retenido, fecha, concepto
             - Comprobante que origina la retención -->

        <template id="report_withholding_certificate_document">
            <t t-call="web.external_layout">
                <t t-set="o" t-value="o.with_context(lang=lang)"/>

                <div class="page" style="font-family: 'Helvetica Neue', Arial, sans-serif; font-size: 12px; color: #333;">

                    <!-- ═══ ENCABEZADO ═══ -->
                    <div style="text-align: center; margin-top: 20px; margin-bottom: 20px;">
                        <h3 style="margin: 0; letter-spacing: 2px; font-weight: bold;">
                            CERTIFICADO DE RETENCIÓN
                        </h3>
                        <div style="font-size: 14px; margin-top: 4px; color: #555;">
                            <t t-esc="o.get_withholding_type_label()"/>
                        </div>
                        <div style="margin-top: 10px; font-size: 13px;">
                            <strong>Nro. Certificado:</strong>
                            <span t-field="o.withholding_number"/>
                            <span style="margin-left: 30px;">
                                <strong>Fecha:</strong>
                                <span t-field="o.date"/>
                            </span>
                        </div>
                    </div>

                    <hr style="border: none; border-top: 2px solid #333; margin: 0 0 15px 0;"/>

                    <!-- ═══ AGENTE DE RETENCIÓN (empresa) ═══ -->
                    <table style="width: 100%; margin-bottom: 15px; border-collapse: collapse;">
                        <tr>
                            <td colspan="2" style="background-color: #e9ecef; padding: 6px 10px; font-weight: bold; font-size: 12px; border: 1px solid #ccc;">
                                AGENTE DE RETENCIÓN
                            </td>
                        </tr>
                        <tr>
                            <td style="width: 50%; padding: 5px 10px; border: 1px solid #ddd; vertical-align: top;">
                                <strong>Razón Social:</strong><br/>
                                <span t-field="o.company_id.name"/>
                            </td>
                            <td style="width: 50%; padding: 5px 10px; border: 1px solid #ddd; vertical-align: top;">
                                <strong>CUIT:</strong><br/>
                                <span t-field="o.company_id.vat"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding: 5px 10px; border: 1px solid #ddd; vertical-align: top;">
                                <strong>Condición frente al IVA:</strong><br/>
                                <span t-field="o.company_id.partner_id.l10n_ar_afip_responsibility_type_id"/>
                            </td>
                            <td style="padding: 5px 10px; border: 1px solid #ddd; vertical-align: top;">
                                <strong>Inicio de Actividades:</strong><br/>
                                <span t-field="o.company_id.l10n_ar_afip_start_date"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding: 5px 10px; border: 1px solid #ddd; vertical-align: top;">
                                <strong>Domicilio Fiscal:</strong><br/>
                                <span t-field="o.company_id.partner_id.street"/>
                                <t t-if="o.company_id.partner_id.street2">
                                    - <span t-field="o.company_id.partner_id.street2"/>
                                </t>
                                <br/>
                                <span t-field="o.company_id.partner_id.city"/>
                                <t t-if="o.company_id.partner_id.state_id">
                                    - <span t-field="o.company_id.partner_id.state_id"/>
                                </t>
                                <t t-if="o.company_id.partner_id.zip">
                                    (<span t-field="o.company_id.partner_id.zip"/>)
                                </t>
                            </td>
                            <td style="padding: 5px 10px; border: 1px solid #ddd; vertical-align: top;">
                                <t t-if="o.is_iibb_withholding()">
                                    <strong>Nro. Ingresos Brutos:</strong><br/>
                                    <span t-field="o.company_id.l10n_ar_gross_income_number"/>
                                </t>
                                <t t-if="o.is_ganancias_withholding()">
                                    <strong>Régimen:</strong><br/>
                                    <span t-esc="o.get_regimen_ganancias_label()"/>
                                </t>
                            </td>
                        </tr>
                    </table>

                    <!-- ═══ SUJETO RETENIDO (proveedor) ═══ -->
                    <table style="width: 100%; margin-bottom: 15px; border-collapse: collapse;">
                        <tr>
                            <td colspan="2" style="background-color: #e9ecef; padding: 6px 10px; font-weight: bold; font-size: 12px; border: 1px solid #ccc;">
                                SUJETO RETENIDO
                            </td>
                        </tr>
                        <tr>
                            <td style="width: 50%; padding: 5px 10px; border: 1px solid #ddd; vertical-align: top;">
                                <strong>Razón Social:</strong><br/>
                                <span t-field="o.partner_id.commercial_partner_id.name"/>
                            </td>
                            <td style="width: 50%; padding: 5px 10px; border: 1px solid #ddd; vertical-align: top;">
                                <strong>CUIT:</strong><br/>
                                <span t-field="o.partner_id.commercial_partner_id.vat"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding: 5px 10px; border: 1px solid #ddd; vertical-align: top;">
                                <strong>Condición frente al IVA:</strong><br/>
                                <span t-field="o.partner_id.commercial_partner_id.l10n_ar_afip_responsibility_type_id"/>
                            </td>
                            <td style="padding: 5px 10px; border: 1px solid #ddd; vertical-align: top;">
                                <strong>Nro. Ingresos Brutos:</strong><br/>
                                <t t-if="o.partner_id.commercial_partner_id.l10n_ar_gross_income_number">
                                    <span t-field="o.partner_id.commercial_partner_id.l10n_ar_gross_income_number"/>
                                </t>
                                <t t-else="">
                                    <span>-</span>
                                </t>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="2" style="padding: 5px 10px; border: 1px solid #ddd; vertical-align: top;">
                                <strong>Domicilio Fiscal:</strong>
                                <span t-field="o.partner_id.commercial_partner_id.street"/>
                                <t t-if="o.partner_id.commercial_partner_id.street2">
                                    - <span t-field="o.partner_id.commercial_partner_id.street2"/>
                                </t>
                                -
                                <span t-field="o.partner_id.commercial_partner_id.city"/>
                                <t t-if="o.partner_id.commercial_partner_id.state_id">
                                    - <span t-field="o.partner_id.commercial_partner_id.state_id"/>
                                </t>
                                <t t-if="o.partner_id.commercial_partner_id.zip">
                                    (<span t-field="o.partner_id.commercial_partner_id.zip"/>)
                                </t>
                            </td>
                        </tr>
                    </table>

                    <!-- ═══ DATOS DE LA RETENCIÓN ═══ -->
                    <table style="width: 100%; margin-bottom: 15px; border-collapse: collapse;">
                        <tr>
                            <td colspan="4" style="background-color: #e9ecef; padding: 6px 10px; font-weight: bold; font-size: 12px; border: 1px solid #ccc;">
                                DETALLE DE LA RETENCIÓN
                            </td>
                        </tr>
                        <tr>
                            <td style="width: 50%; padding: 5px 10px; border: 1px solid #ddd;">
                                <strong>Impuesto:</strong><br/>
                                <span t-field="o.tax_withholding_id"/>
                            </td>
                            <td style="width: 50%; padding: 5px 10px; border: 1px solid #ddd;">
                                <strong>Régimen:</strong><br/>
                                <t t-if="o.is_iibb_withholding()">
                                    Régimen General - IIBB Provincia de Buenos Aires
                                </t>
                                <t t-if="o.is_ganancias_withholding()">
                                    <span t-esc="o.get_regimen_ganancias_label()"/>
                                </t>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding: 5px 10px; border: 1px solid #ddd;">
                                <strong>Fecha de Retención:</strong><br/>
                                <span t-field="o.date"/>
                            </td>
                            <td style="padding: 5px 10px; border: 1px solid #ddd;">
                                <strong>Nro. Comprobante de Pago:</strong><br/>
                                <t t-if="o.payment_group_id">
                                    <span t-field="o.payment_group_id.display_name"/>
                                </t>
                            </td>
                        </tr>
                    </table>

                    <!-- ═══ LIQUIDACIÓN ═══ -->
                    <table style="width: 100%; margin-bottom: 15px; border-collapse: collapse;">
                        <tr>
                            <td colspan="3" style="background-color: #e9ecef; padding: 6px 10px; font-weight: bold; font-size: 12px; border: 1px solid #ccc;">
                                LIQUIDACIÓN
                            </td>
                        </tr>
                        <tr style="text-align: center;">
                            <td style="width: 33%; padding: 8px 10px; border: 1px solid #ddd;">
                                <strong>Base Imponible</strong>
                            </td>
                            <td style="width: 33%; padding: 8px 10px; border: 1px solid #ddd;">
                                <strong>Alícuota</strong>
                            </td>
                            <td style="width: 34%; padding: 8px 10px; border: 1px solid #ddd;">
                                <strong>Importe Retenido</strong>
                            </td>
                        </tr>
                        <tr style="text-align: center; font-size: 14px;">
                            <td style="padding: 10px; border: 1px solid #ddd;">
                                <span t-field="o.withholdable_base_amount"
                                      t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                            </td>
                            <td style="padding: 10px; border: 1px solid #ddd;">
                                <t t-set="alicuota" t-value="o.get_withholding_alicuota()"/>
                                <t t-if="alicuota == -1">
                                    Según escala
                                </t>
                                <t t-else="">
                                    <span t-esc="'{:.2f} %'.format(alicuota)"/>
                                </t>
                            </td>
                            <td style="padding: 10px; border: 1px solid #ddd; font-weight: bold;">
                                <span t-field="o.amount"
                                      t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                            </td>
                        </tr>
                    </table>

                    <!-- ═══ COMPROBANTES QUE ORIGINAN LA RETENCIÓN ═══ -->
                    <t t-set="invoices" t-value="o.get_withholding_invoices()"/>
                    <t t-if="invoices">
                        <table style="width: 100%; margin-bottom: 15px; border-collapse: collapse;">
                            <tr>
                                <td colspan="5" style="background-color: #e9ecef; padding: 6px 10px; font-weight: bold; font-size: 12px; border: 1px solid #ccc;">
                                    COMPROBANTES QUE ORIGINAN LA RETENCIÓN
                                </td>
                            </tr>
                            <tr style="background-color: #f8f9fa; text-align: center;">
                                <th style="padding: 6px; border: 1px solid #ddd;">Fecha</th>
                                <th style="padding: 6px; border: 1px solid #ddd;">Tipo y Nro. Comprobante</th>
                                <th style="padding: 6px; border: 1px solid #ddd;">Referencia</th>
                                <th style="padding: 6px; border: 1px solid #ddd; text-align: right;">Importe Total</th>
                                <th style="padding: 6px; border: 1px solid #ddd; text-align: right;">Saldo</th>
                            </tr>
                            <t t-foreach="invoices" t-as="inv">
                                <tr>
                                    <td style="padding: 5px; border: 1px solid #ddd; text-align: center;">
                                        <span t-field="inv.invoice_date"/>
                                    </td>
                                    <td style="padding: 5px; border: 1px solid #ddd;">
                                        <span t-field="inv.name"/>
                                    </td>
                                    <td style="padding: 5px; border: 1px solid #ddd;">
                                        <span t-field="inv.ref"/>
                                    </td>
                                    <td style="padding: 5px; border: 1px solid #ddd; text-align: right;">
                                        <span t-field="inv.amount_total"
                                              t-options="{'widget': 'monetary', 'display_currency': inv.currency_id}"/>
                                    </td>
                                    <td style="padding: 5px; border: 1px solid #ddd; text-align: right;">
                                        <span t-field="inv.amount_residual"
                                              t-options="{'widget': 'monetary', 'display_currency': inv.currency_id}"/>
                                    </td>
                                </tr>
                            </t>
                        </table>
                    </t>

                    <!-- ═══ OBSERVACIONES ═══ -->
                    <t t-if="o.communication">
                        <table style="width: 100%; margin-bottom: 15px; border-collapse: collapse;">
                            <tr>
                                <td style="background-color: #e9ecef; padding: 6px 10px; font-weight: bold; font-size: 12px; border: 1px solid #ccc;">
                                    OBSERVACIONES
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 8px 10px; border: 1px solid #ddd;">
                                    <span t-field="o.communication"/>
                                </td>
                            </tr>
                        </table>
                    </t>

                    <!-- ═══ FIRMA ═══ -->
                    <div style="margin-top: 60px; text-align: right; padding-right: 40px;">
                        <div style="display: inline-block; text-align: center; width: 250px;">
                            <div style="border-top: 1px solid #333; padding-top: 5px; margin-top: 60px; font-size: 11px;">
                                Firma y Sello del Agente de Retención
                            </div>
                        </div>
                    </div>

                    <!-- ═══ PIE LEGAL ═══ -->
                    <div style="margin-top: 30px; font-size: 9px; color: #888; text-align: center;">
                        Este certificado debe ser conservado por el sujeto retenido como constancia de la retención practicada.
                        <br/>
                        Emitido por sistema - Original para el retenido / Duplicado para el agente de retención.
                    </div>

                </div>
            </t>
        </template>

        <!-- Template wrapper que itera los docs. -->
        <template id="report_withholding_certificate">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="arba.report_withholding_certificate_document"
                       t-lang="o.partner_id.lang"/>
                </t>
            </t>
        </template>

        <!-- Override del ir.actions.report existente de OCA. -->
        <record id="l10n_ar_report_withholding.action_payment_withholdings" model="ir.actions.report">
            <field name="report_name">arba.report_withholding_certificate</field>
            <field name="report_file">arba.report_withholding_certificate</field>
            <field name="print_report_name">'Certificado Retención - %s' % (object.withholding_number or object.name)</field>
        </record>

    </data>
</odoo>
