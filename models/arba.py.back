    def crear_o_actualizar_cron_unico(self, xml_id, nombre_funcion_modelo, modelo):
        """
        Crea o actualiza una acción planificada para que se ejecute una vez en los próximos 5 minutos.
        - xml_id: string con el ID externo del cron (por ejemplo: 'arba.ejecutar_una_vez')
        - nombre_funcion_modelo: string con el nombre de la función que se quiere ejecutar
        - modelo: string con el nombre técnico del modelo (por ejemplo: 'arba.archivo_comprimido')
        """

        # Calcula fecha actual + 5 minutos
        fecha_ejecucion = datetime.now() + timedelta(minutes=2)

        # Intentar obtener el cron
        cron = self.env.ref(xml_id, raise_if_not_found=False)

        if cron:
            # Solo actualizar la fecha de ejecución y asegurarse que esté activo y se ejecute una vez
            cron.write({
                'nextcall': fecha_ejecucion,
                'interval_number': 1,
                'interval_type': 'months',
                'numbercall': 1,
                'active': True,
            })
        else:
            # Crear el cron desde cero
            self.env['ir.cron'].create({
                'name': 'Ejecución única para ARBA',
                'model_id': self.env['ir.model']._get(modelo).id,
                'state': 'code',
                'code': f'model._procesar_txt_a_padron_perc()',
                'interval_number':1,
                'interval_type': 'months',
                'numbercall': 1,
                'nextcall': fecha_ejecucion,
                'active': True,
                'user_id': self.env.user.id,
                'doall': False,
            })
